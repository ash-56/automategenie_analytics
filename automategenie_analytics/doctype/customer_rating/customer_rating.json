{
 "doctype": "DocType",
 "name": "Customer Rating",
 "module": "AutomateGenie Analytics",
 "autoname": "format:AG-RAT-{####}",
 "naming_rule": "Expression",
 "field_order": [
  "ag_delivery",
  "ag_customer",
  "ag_sales_order",
  "region",
  "product",
  "sales_person",
  "rating",
  "feedback",
  "posting_date"
 ],
 "fields": [
  {
   "fieldname": "ag_delivery",
   "fieldtype": "Link",
   "label": "Delivery",
   "options": "AG Delivery",
   "reqd": 1
  },
  {
   "fieldname": "ag_customer",
   "fieldtype": "Link",
   "label": "Customer",
   "options": "AG Customer"
  },
  {
   "fieldname": "ag_sales_order",
   "fieldtype": "Link",
   "label": "Sales Order",
   "options": "AG Sales Order"
  },
  {
