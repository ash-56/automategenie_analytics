   "options": "North\nSouth\nEast\nWest\nCentral"
  },
  {
   "fieldname": "product",
   "fieldtype": "Select",
   "label": "Product",
   "options": "Product A\nProduct B\nProduct C\nService X\nService Y"
  },
  {
   "fieldname": "sales_person",
   "fieldtype": "Select",
   "label": "Sales Person",
   "options": "Rahul\nPriya\nAmit\nSneha\nVikram"
  },
  {
   "fieldname": "rating",
   "fieldtype": "Int",
   "label": "Rating (1-5)"
  },
  {
   "fieldname": "feedback",
   "fieldtype": "Small Text",
   "label": "Feedback"
  },
  {
   "fieldname": "posting_date",
   "fieldtype": "Date",
   "label": "Posting Date"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  }
 ]
}